# Copy to .env and adjust. Not loaded automatically: pass it to Docker with
# `docker run --env-file .env ...`, or export the variables before `dotnet run`.

# Required
MSSQL_SERVER=localhost
MSSQL_USER=SA
MSSQL_PASSWORD=your_Strong_Passw0rd

# Optional
MSSQL_PORT=1433
ENCRYPT=true
TRUST_SERVER_CERTIFICATE=true
EXPOSE=4000
COLLECT_DEFAULT_METRICS=true
# Log levels per category (App, Db, Metrics); the default is Information.
Logging__LogLevel__App=Debug
