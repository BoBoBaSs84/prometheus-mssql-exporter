{
  "name": "prometheus-mssql-exporter",
  "version": "2.0.0",
  "type": "module",
  "main": "src/index.js",
  "private": false,
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "prometheus",
    "mssql",
    "exporter",
    "metrics"
  ],
  "author": {
    "name": "Pierre Awaragi",
    "email": "pierre@awaragi.com"
  },
  "license": "MIT",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaragi/prometheus-mssql-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/awaragi/prometheus-mssql-exporter/issues"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "metrics": "node src/metrics-docs.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --project unit --coverage",
    "test:mssql:2019": "docker run --name mssql --rm -e ACCEPT_EULA=Y -e MSSQL_SA_PASSWORD=$MSSQL_SA_PASSWORD -p 1433:1433 mcr.microsoft.com/mssql/server:2019-latest",
    "test:mssql:2022": "docker run --name mssql --rm -e ACCEPT_EULA=Y -e MSSQL_SA_PASSWORD=$MSSQL_SA_PASSWORD -p 1433:1433 mcr.microsoft.com/mssql/server:2022-latest",
    "test:mssql:2025": "docker run --name mssql --rm -e ACCEPT_EULA=Y -e MSSQL_SA_PASSWORD=$MSSQL_SA_PASSWORD -p 1433:1433 mcr.microsoft.com/mssql/server:2025-latest",
    "docker:build": "docker build . -t awaragi/prometheus-mssql-exporter"
  },
  "dependencies": {
    "debug": "4.4.3",
    "express": "5.2.1",
    "prom-client": "15.1.3",
    "tedious": "20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/mssqlserver": "12.1.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "vitest": "5.0.0"
  }
}
